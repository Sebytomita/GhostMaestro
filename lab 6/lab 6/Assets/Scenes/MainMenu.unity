    m_PersistentCalls:
      m_Calls: []
  m_text: "CONTROLS / LEGENDA\r\n\r\nDeplasare:\r\n  \u2022 W / A / S / D \u2013
    mi\u0219care \xEEnainte / st\xE2nga / \xEEnapoi / dreapta\r\n  \u2022 Shift \u2013
    alergare (sprint)\r\n  \u2022 Space \u2013 s\u0103ritur\u0103\r\n  \u2022 Ctrl
    \u2013 aplecare (crouch)\r\n\r\nPrivire / Camer\u0103:\r\n  \u2022 Mouse \u2013
    prive\u0219te \xEEn jur\r\n  \u2022 Esc \u2013 meniu pauz\u0103\r\n\r\nInterac\u021Biune:\r\n 
    \u2022 T \u2013 select (ray interactor) m\xE2na st\xE2ng\u0103 (simulator)\r\n 
    \u2022 Y \u2013 select (ray interactor) m\xE2na dreapt\u0103 (simulator)\r\n 
    \u2022 G \u2013 grab / release obiectul vizat\r\n  \u2022 X \u2013 toggle panou
    interac\u021Biune (deschide/\xEEnchide)\r\n\r\nTeleport / Rotire (dac\u0103 e
    configurat):\r\n  \u2022 Q / E \u2013 snap turn st\xE2nga/dreapta\r\n  \u2022
    R \u2013 teleport (activare indicator), Click \u2013 confirm\u0103\r\n\r\nUI:\r\n 
    \u2022 Click st\xE2nga \u2013 apas\u0103 buton UI\r\n  \u2022 Scroll \u2013 deruleaz\u0103
    liste/panouri\r\n\r\nAudio:\r\n  \u2022 M \u2013 mute/unmute\r\n  \u2022 +/-
    \u2013 volum mai mic/mare (op\u021Bional)\r\n\r\nDiverse:\r\n  \u2022 F \u2013
    lantern\u0103 (dac\u0103 exist\u0103)\r\n  \u2022 Tab \u2013 inventar / jurnal
    (dac\u0103 exist\u0103)\r\n"
  m_isRightToLeft: 0
