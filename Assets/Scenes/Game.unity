  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=56><color=#FFD700><b>CONTROALE</b></color></size>\n\n\n<size=42><color=#9FE2BF><b>
    PRIN CAS\u0102</b></color></size>\n\n<size=36><color=#FFD700><b>W A S D</b></color>
    \u2014 <color=#FFFFFF>mi\u0219care</color>\n<color=#FFD700><b>Mouse</b></color>
    \u2014 <color=#FFFFFF>prive\u0219te \xEEn jur</color>\n<color=#FFD700><b>X</b></color>
    \u2014 <color=#FFFFFF>a\u0219az\u0103-te la pian</color></size>\n\n\n<size=42><color=#9FE2BF><b>
    LA PIAN</b></color></size>\n\n<size=36><color=#87CEEB><b>Click dreapta + Mouse</b></color>
    \u2014 <color=#FFFFFF>prive\u0219te \xEEn jur</color>\n<color=#87CEEB><b>ESC</b></color>
    \u2014 <color=#FFFFFF>ridic\u0103-te de la pian</color>\n<color=#87CEEB><b>Enter</b></color>
    \u2014 <color=#FFFFFF>confirm\u0103 (la final de lec\u021Bie)</color></size>\n\n\n<size=42><color=#9FE2BF><b>
    CLAPELE PIANULUI</b></color></size>\n\n<size=36><color=#FF69B4><b>Q W E R T Y
    U I</b></color>\n<color=#FFFFFF>DO4 \u2014 RE4 \u2014 MI4 \u2014 FA4 \u2014 SOL4
    \u2014 LA4 \u2014 SI4 \u2014 DO5</color>\n\n<color=#FF69B4><b>A S D F G H J</b></color>\n<color=#FFFFFF>DO5
    \u2014 RE5 \u2014 MI5 \u2014 FA5 \u2014 SOL5 \u2014 LA5 \u2014 SI5</color>\n\n<color=#FF69B4><b>Z
    X C V B N M</b></color>\n<color=#FFFFFF>DO6 \u2014 RE6 \u2014 MI6 \u2014 FA6
    \u2014 SOL6 \u2014 LA6 \u2014 FA#6</color></size>\n\n\n<size=42><color=#9FE2BF><b>
    DEBUG</b></color></size>\n\n<size=36><color=#CCCCCC><b>F2</b></color> \u2014
    <color=#FFFFFF>sari la lec\u021Bia urm\u0103toare</color>\n<color=#CCCCCC><b>F3</b></color>
    \u2014 <color=#FFFFFF>restart lec\u021Bie curent\u0103</color></size>\n\n\n<size=42><color=#9FE2BF><b>
    MENIU PAUZ\u0102</b></color></size>\n\n<size=36><color=#FFA500><b>Tab</b></color>
    \u2014 <color=#FFFFFF>deschide/\xEEnchide controalele (\xEEn cas\u0103)</color></size>"
